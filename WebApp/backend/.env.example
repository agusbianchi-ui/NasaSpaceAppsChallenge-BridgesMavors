APP_NAME=MARS OPS API
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
# Production: exact HTTPS origin, without a path; comma-separated for multiple origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
NASA_REQUEST_TIMEOUT_SECONDS=20
AEOLIAN_DATA_ROOT=../mars_ml/datasets/mars
# MARS_SCIENCE_DATA_DIR defaults to the repository's output-stage4 directory.
